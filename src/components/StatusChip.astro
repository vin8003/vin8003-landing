---
import type { Status } from '../data/site';
import { statusNote } from '../data/site';

interface Props {
  status: Status;
  class?: string;
}

const { status, class: className = '' } = Astro.props;

// LIVE borrows the surrounding product accent where one is set, so a chip
// inside a product card reads as part of that product, not a generic badge.
// The label carries the state; there is no decorative dot.
const tone: Record<Status, string> = {
  LIVE: 'color: var(--accent, var(--color-mint))',
  BUILDING: 'color: var(--color-paper-dim)',
  EXPERIMENT: 'color: var(--color-paper-faint)',
};
---

<span class={`chip ${className}`} style={tone[status]} title={statusNote[status]}>
  {status}
</span>
