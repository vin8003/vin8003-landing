---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { thesis, stack } from '../data/site';
---

<section id="thesis" class="relative scroll-mt-20 overflow-hidden border-t border-ink-600/70 py-16 sm:py-24 lg:py-28">
  <div class="grid-substrate pointer-events-none absolute inset-0 opacity-60"></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-72 opacity-[0.16]"
    style="background: radial-gradient(42rem 18rem at 18% 0%, var(--color-ember), transparent 70%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative">
    <SectionHead index="04" label="Thesis" title="One job each." />

    <blockquote class="mt-10 max-w-4xl sm:mt-14" data-reveal>
      <p class="font-display text-title text-paper">
        <span class="reveal-line"><span><span class="text-ember">“</span>{thesis.line}</span></span>
      </p>
    </blockquote>

    <div class="mt-10 grid gap-10 sm:mt-14 lg:grid-cols-12 lg:gap-14">
      <div class="flex flex-col gap-6 text-lead text-paper-dim lg:col-span-7">
        {
          thesis.body.map((para, i) => (
            <p data-reveal style={`--reveal-delay:${i * 70}ms`}>
              {para}
            </p>
          ))
        }
      </div>

      <aside class="flex flex-col gap-3 lg:col-span-5">
        <div
          class="rounded-2xl border border-dashed border-ink-500/80 bg-ink-850/40 p-5 sm:p-6"
          data-reveal
          style="--reveal-delay:120ms"
        >
          <div class="flex items-center justify-between gap-3">
            <p class="label-mono">Parked</p>
            <StatusChip status={thesis.parked.status} />
          </div>
          <p class="mt-4 font-display text-sub text-paper">{thesis.parked.name}</p>
          <p class="mt-3 text-fine leading-relaxed text-paper-dim">{thesis.parked.note}</p>
        </div>

        <div
          class="rounded-2xl border border-ink-600/80 bg-ink-850/60 p-5 sm:p-6"
          data-reveal
          style="--reveal-delay:180ms"
        >
          <p class="label-mono">What the assistants are built with</p>
          <dl class="mt-5 flex flex-col gap-4">
            {
              stack.map((group) => (
                <div class="border-t border-ink-600/60 pt-4 first:border-t-0 first:pt-0">
                  <dt class="text-fine text-paper-faint">{group.group}</dt>
                  <dd class="mt-2 flex flex-wrap gap-1.5">
                    {group.items.map((item) => (
                      <span class="rounded-full border border-ink-500/80 bg-ink-800 px-3 py-1 font-mono text-[0.68rem] text-paper">
                        {item}
                      </span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
