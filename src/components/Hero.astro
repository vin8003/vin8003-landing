---
import { person, demoHub } from '../data/site';

const lines = [
  { text: 'I ship products', tint: '' },
  { text: 'for the shop counter,', tint: 'text-mint' },
  { text: 'the law chamber,', tint: 'text-violet' },
  { text: 'and the GST file.', tint: 'text-amber' },
];
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col justify-between overflow-hidden pt-24 sm:pt-28"
  data-hero
>
  {/* Substrate + light */}
  <div class="grid-substrate pointer-events-none absolute inset-0 -z-20"></div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-70 transition-opacity duration-700"
    style="background: radial-gradient(46rem 34rem at var(--px, 50%) var(--py, 22%), color-mix(in oklab, var(--color-ember) 15%, transparent), transparent 70%);"
    data-spotlight
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-64 bg-gradient-to-b from-transparent to-ink-900"
  >
  </div>

  <div class="container-page flex flex-1 flex-col justify-center py-10 sm:py-14">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
      <span class="flex items-center gap-2">
        <span class="relative flex size-1.5">
          <span class="absolute inset-0 rounded-full bg-mint" data-anim style="animation: soft-pulse 2.4s ease-in-out infinite;"></span>
          <span class="relative size-1.5 rounded-full bg-mint"></span>
        </span>
        <span class="label-mono text-paper-dim">Building now</span>
      </span>
      <span class="hidden h-3 w-px bg-ink-500 sm:block"></span>
      <span class="label-mono">{person.location}</span>
    </div>

    <h1
      class="mt-6 font-display text-hero sm:mt-8"
      aria-label={lines.map((l) => l.text).join(' ')}
      data-reveal
    >
      {
        lines.map((line, i) => (
          <span class="reveal-line" style={`--reveal-delay:${i * 90}ms`}>
            <span class={line.tint}>{line.text}</span>
          </span>
        ))
      }
    </h1>

    <div class="mt-8 grid gap-8 sm:mt-12 lg:grid-cols-12 lg:items-end lg:gap-10">
      <p class="max-w-2xl text-lead text-paper-dim lg:col-span-7" data-reveal style="--reveal-delay:180ms">
        {person.bio}
      </p>

      <div class="flex flex-col gap-4 lg:col-span-5 lg:items-end" data-reveal style="--reveal-delay:260ms">
        <div class="flex flex-wrap gap-2.5 sm:gap-3">
          <a
            href="#work"
            class="group inline-flex items-center gap-2 rounded-full bg-paper px-5 py-3 text-body font-medium text-ink-900 transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0 sm:px-6"
          >
            See the work
            <svg viewBox="0 0 16 16" class="size-3.5 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M8 2.5v11M3.5 9.5 8 14l4.5-4.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href={`${demoHub}/`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 rounded-full border border-ink-500 px-5 py-3 text-body text-paper transition-colors duration-200 hover:border-paper-faint hover:bg-ink-800 sm:px-6"
          >
            Open the demo hub
            <svg viewBox="0 0 16 16" class="size-3.5 text-paper-faint transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <p class="label-mono max-w-xs leading-relaxed lg:text-right">
          Three products, four surfaces. Real seed data. No invented metrics.
        </p>
      </div>
    </div>
  </div>

  {/* Product rail — doubles as a table of contents for the page. */}
  <div class="relative border-t border-ink-600/70 bg-ink-900/40 backdrop-blur-sm" data-reveal style="--reveal-delay:340ms">
    <div class="container-page grid grid-cols-1 divide-y divide-ink-600/70 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {
        [
          { name: 'OrderEasy', note: 'Retailer + customer shop SaaS', href: '#ordereasy-retailer', dot: 'bg-mint' },
          { name: 'CiteBench', note: 'Case-law research desk', href: '#citebench', dot: 'bg-violet' },
          { name: 'GSTSlip', note: 'India GST invoice capture', href: '#gstslip', dot: 'bg-amber' },
        ].map((p) => (
          <a href={p.href} class="group flex items-center justify-between gap-4 py-4 transition-colors duration-200 hover:bg-ink-800/60 sm:px-5 sm:py-6 sm:first:pl-0">
            <span class="flex min-w-0 items-baseline gap-2.5 sm:flex-col sm:items-start sm:gap-1.5">
              <span class="flex items-center gap-2 text-body font-medium">
                <span class={`size-1.5 shrink-0 rounded-full ${p.dot}`} />
                {p.name}
              </span>
              <span class="truncate text-fine text-paper-faint">{p.note}</span>
            </span>
            <svg viewBox="0 0 16 16" class="size-3.5 shrink-0 text-paper-faint transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Pointer-tracked light. Fine pointers only — no cost on touch devices.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const spotlight = document.querySelector<HTMLElement>('[data-spotlight]');
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && spotlight && finePointer && !reduced) {
    let frame = 0;
    hero.addEventListener(
      'pointermove',
      (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const rect = hero.getBoundingClientRect();
          spotlight.style.setProperty('--px', `${((event.clientX - rect.left) / rect.width) * 100}%`);
          spotlight.style.setProperty('--py', `${((event.clientY - rect.top) / rect.height) * 100}%`);
        });
      },
      { passive: true },
    );
  }
</script>
