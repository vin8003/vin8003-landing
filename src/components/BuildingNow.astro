---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import Frame from './Frame.astro';
import { ventures, type Venture } from '../data/site';
import { demos, demoMedia } from '../data/demos';
import { ArrowUpRight, ShieldCheck } from 'lucide-react';

const [orderEasy, citeBench, gstSlip] = ventures as [Venture, Venture, Venture];

const isInternal = (href: string) => href.startsWith('/');

// Real captures from the demo player, so a card and the walkthrough never disagree.
const shot = (id: string, image: string) => {
  const demo = demos.find((d) => d.id === id)!;
  return demoMedia(demo, demo.steps.find((st) => st.image === image)!);
};
---

<section id="building" class="relative scroll-mt-20 py-16 sm:py-24 lg:py-28" data-atmos="ember" data-atmos-intensity="0.5">
  <div class="container-page">
    <SectionHead
      title="Three products, and what each one refuses to be."
      note="Every product here is live, a URL you can open today, and each carries its own line saying what it is not. The previews are real screens captured on seed data."
    />

    <div class="mt-10 grid gap-4 sm:mt-14 sm:gap-5 lg:grid-cols-12">
      {
        [orderEasy, citeBench, gstSlip].map((v, i) => {
          const wide = i === 0;
          return (
            <article
              id={v.id}
              class:list={[
                'spot ring-gradient group relative flex scroll-mt-24 flex-col overflow-hidden rounded-2xl bg-ink-850',
                wide ? 'lg:col-span-12 lg:grid lg:grid-cols-12 lg:items-center' : 'lg:col-span-6',
              ]}
              style={`--accent: var(--color-${v.accent}); --reveal-delay:${i * 90}ms`}
              data-reveal
              data-spot
              data-tilt={wide ? '2.5' : '5'}
              data-atmos={v.accent}
              data-atmos-intensity="0.75"
            >
              <div class:list={['relative flex flex-col p-6 sm:p-8', wide && 'lg:col-span-5 lg:p-10']}>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-display text-title" style="color: var(--accent)">
                    {v.name}
                  </h3>
                  <StatusChip status={v.status} class="mt-3" />
                </div>

                <p class="mt-2 text-fine text-paper-faint">{v.kind}</p>

                <p class="mt-4 max-w-md text-lead text-paper-dim">{v.what}</p>

                <blockquote class="mt-5 flex items-start gap-3 text-fine leading-relaxed text-paper">
                  <ShieldCheck className="mt-0.5 size-4 shrink-0" style={{ color: "var(--accent)" }} strokeWidth={1.5} aria-hidden="true" />
                  <span>{v.guardrail}</span>
                </blockquote>

                <div class="mt-7 flex flex-wrap items-center gap-2.5">
                  <a
                    href={v.primary.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/link inline-flex max-w-full items-center gap-2 rounded-full px-4 py-2.5 text-fine font-semibold text-ink-900 transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]"
                    style="background: var(--accent);"
                  >
                    <span class="truncate">{v.primary.label}</span>
                    <ArrowUpRight className="size-3 shrink-0 opacity-70 transition-transform duration-300 group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5" strokeWidth={1.8} aria-hidden="true" />
                  </a>
                </div>

                <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
                  {v.surfaces.map((s) => (
                    <li>
                      <a
                        href={s.href}
                        target={isInternal(s.href) ? undefined : '_blank'}
                        rel={isInternal(s.href) ? undefined : 'noopener noreferrer'}
                        class:list={['label-mono transition-colors duration-200 hover:text-paper', isInternal(s.href) && 'text-paper-dim']}
                      >
                        {isInternal(s.href) ? s.label : `${s.label} ↗`}
                      </a>
                    </li>
                  ))}
                </ul>

                {v.note && <p class="label-mono mt-4 text-[0.6rem]">{v.note}</p>}
              </div>

              {/* Visual: real captures only. */}
              <div
                class:list={[
                  'relative px-4 pb-4 sm:px-8 sm:pb-8',
                  wide ? 'lg:col-span-7 lg:py-10 lg:pl-0 lg:pr-10' : '',
                ]}
              >
                {v.id === 'ordereasy' && (
                  <div class="line-reveal relative">
                    <Frame variant="browser" url="retailer.ordereasy.win">
                      <img
                        src={shot('retailer', 'retailer-overview.jpg')}
                        alt="OrderEasy retailer dashboard showing four shop KPIs for the selected range"
                        width="1280"
                        height="656"
                        loading="lazy"
                        decoding="async"
                        class="block h-auto w-full"
                      />
                    </Frame>
                    <div class="absolute -bottom-10 -right-3 hidden w-[9.5rem] sm:block lg:-right-5 lg:w-[10.5rem]">
                      <Frame variant="phone">
                        <img
                          src={shot('customer', 'customer-shop-list.jpg')}
                          alt="OrderEasy customer app listing nearby shops"
                          width="780"
                          height="1688"
                          loading="lazy"
                          decoding="async"
                          class="block h-auto w-full"
                        />
                      </Frame>
                    </div>
                  </div>
                )}
                {v.id === 'citebench' && (
                  <div class="line-reveal max-h-[22rem] overflow-hidden rounded-2xl [mask-image:linear-gradient(to_bottom,#000_70%,transparent)]">
                    <Frame variant="browser" url="citebench.ordereasy.win">
                      <img
                        src={shot('citebench', 'citebench-today.jpg')}
                        alt="CiteBench Today screen showing a chamber's day"
                        width="2160"
                        height="1350"
                        loading="lazy"
                        decoding="async"
                        class="block h-auto w-full"
                      />
                    </Frame>
                  </div>
                )}
                {v.id === 'gstslip' && (
                  <div class="line-reveal max-h-[22rem] overflow-hidden rounded-2xl [mask-image:linear-gradient(to_bottom,#000_70%,transparent)]">
                    <Frame variant="browser" url="gstslip.vin8003.com">
                      <img
                        src={shot('gstslip', 'gstslip-extracted-fields.jpg')}
                        alt="GSTSlip showing fields extracted from a GST invoice"
                        width="1280"
                        height="800"
                        loading="lazy"
                        decoding="async"
                        class="block h-auto w-full"
                      />
                    </Frame>
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
