---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import DemoPlayer from '../components/DemoPlayer.astro';
import Footer from '../components/Footer.astro';
import { demos } from '../data/demos';

const totalSteps = demos.reduce((n, d) => n + d.steps.length, 0);
---

<Base
  title="Product demos — vin8003.com"
  description={`Guided walkthroughs of OrderEasy, CiteBench and GSTSlip: ${totalSteps} real screens on seed data, no sign-up.`}
  skipTo="#demos"
>
  <Nav home={false} />

  <main>
    <section id="demos" class="relative isolate overflow-hidden pb-16 pt-28 sm:pb-24 sm:pt-36">
      <div class="grid-substrate pointer-events-none absolute inset-0 -z-20 [mask-image:radial-gradient(ellipse_at_50%_20%,#000_30%,transparent_75%)]"></div>
      <div class="aurora" aria-hidden="true">
        <span class="-left-24 -top-24 h-[30rem] w-[30rem]" style="background: var(--color-ember); opacity: 0.4"></span>
        <span class="-right-24 top-10 h-[26rem] w-[26rem]" style="background: var(--color-violet); opacity: 0.35"></span>
        <span class="bottom-0 left-1/3 h-[22rem] w-[22rem]" style="background: var(--color-mint); opacity: 0.22"></span>
      </div>

      <div class="container-page">
        <a href="/" class="label-mono transition-colors hover:text-paper">← vin8003.com</a>
        <div class="mt-6 flex flex-col gap-5" data-reveal>
          <p class="label-mono text-ember">Product demos</p>
          <h1 class="max-w-4xl font-display text-title">
            <span class="reveal-line"><span>Four journeys. <span class="text-gradient">{totalSteps} real screens.</span></span></span>
          </h1>
          <p class="max-w-2xl text-lead text-paper-dim">
            OrderEasy from both sides of the counter, a CiteBench chamber, and a GSTSlip capture — each walked step
            by step on seed data. No sign-up, nothing to install. Arrow keys move between steps; click a screen to
            see it full size.
          </p>
        </div>

        <div class="mt-10 sm:mt-14" data-reveal style="--reveal-delay:120ms">
          <DemoPlayer syncHash />
        </div>
      </div>
    </section>

    <Footer />
  </main>
</Base>
