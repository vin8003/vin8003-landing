---
import { nav, person } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<div
  aria-hidden="true"
  class="fixed inset-x-0 top-0 z-[60] h-px origin-left scale-x-0 bg-ember"
  data-scroll-progress
>
</div>

<header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500"
  data-nav
>
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-[4.5rem]">
    <a href="#top" class="group flex items-center gap-2.5 sm:gap-3" aria-label={`${person.name} — home`}>
      <span
        class="grid size-8 shrink-0 place-items-center rounded-[0.6rem] border border-ink-500 bg-ink-800 font-mono text-[0.7rem] font-semibold tracking-tight text-paper transition-colors duration-300 group-hover:border-ember group-hover:text-ember sm:size-9 sm:text-xs"
        >VS</span
      >
      <span class="flex min-w-0 flex-col leading-none">
        <span class="truncate font-mono text-[0.85rem] font-semibold tracking-tight sm:text-[0.9rem]">{person.name}</span>
        <span class="label-mono mt-1 hidden text-[0.6rem] sm:block">{person.thesisLine}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Sections">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-section-link
            class="rounded-full px-3.5 py-2 text-fine text-paper-dim transition-colors duration-200 hover:bg-ink-700 hover:text-paper"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <a
        href="https://x.com/vin8003"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden size-9 place-items-center rounded-full border border-ink-500 text-paper-dim transition-colors duration-200 hover:border-paper-faint hover:text-paper sm:grid"
        aria-label="Vineet Sharma on X"
      >
        <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
          <path
            d="M18.9 1.6h3.4l-7.4 8.5 8.7 11.5h-6.8l-5.3-7-6.1 7H1.9l7.9-9.1L1.5 1.6h7l4.8 6.4ZM17.7 19.5h1.9L7.3 3.6H5.3Z"
          ></path>
        </svg>
      </a>
      <a
        href={`mailto:${person.email}`}
        class="rounded-full bg-paper px-4 py-2 text-fine font-medium text-ink-900 transition-transform duration-200 hover:-translate-y-px active:translate-y-0 sm:px-5"
      >
        Email
      </a>
    </div>
  </div>
</header>

{/* Thumb-reach nav for tall phone screens. */}
<nav
  class="fixed inset-x-0 bottom-0 z-50 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-10 lg:hidden"
  aria-label="Sections"
>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-full bg-gradient-to-t from-ink-900 via-ink-900/85 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto flex max-w-sm items-center justify-between gap-1 rounded-full border border-ink-500/80 bg-ink-800/85 p-1 backdrop-blur-xl"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-label={item.label}
          data-section-link
          class="flex-1 whitespace-nowrap rounded-full px-1.5 py-2.5 text-center text-[0.74rem] font-medium text-paper-dim transition-colors duration-200 active:bg-ink-600 active:text-paper"
        >
          {item.short}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const solid = ['bg-ink-900/92', 'backdrop-blur-xl', 'border-b', 'border-ink-600/70'];

  let ticking = false;
  const update = () => {
    ticking = false;
    const y = window.scrollY;
    header?.classList.toggle('shadow-[0_1px_0_0_rgba(255,255,255,0.04)]', y > 24);
    solid.forEach((c) => header?.classList.toggle(c, y > 24));

    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
    }
  };

  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();
</script>
