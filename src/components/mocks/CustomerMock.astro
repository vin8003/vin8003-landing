---
const items = [
  { name: 'Toor Dal', pack: '1 kg', price: 168, added: true },
  { name: 'Full Cream Milk', pack: '500 ml', price: 34, added: true },
  { name: 'Atta', pack: '5 kg', price: 245, added: true },
  { name: 'Refined Oil', pack: '1 L', price: 152, added: false },
  { name: 'Basmati Rice', pack: '5 kg', price: 520, added: false },
];
---

<div class="flex h-[30rem] flex-col bg-ink-900 pt-7 @[16rem]:h-[32rem]">
  {/* Status bar */}
  <div class="flex items-center justify-between px-4 pb-1.5 font-mono text-[0.58rem] text-paper-faint">
    <span>9:41</span>
    <span class="flex items-center gap-1">
      <span class="h-2 w-3 rounded-[2px] border border-current"></span>
      <span>OrderEasy</span>
    </span>
  </div>

  {/* Shop header */}
  <div class="border-b border-ink-600/70 px-4 pb-3 pt-1.5">
    <div class="flex items-center gap-2.5">
      <span class="grid size-8 shrink-0 place-items-center rounded-xl bg-[var(--accent)] font-mono text-[0.65rem] font-bold text-ink-900">G</span>
      <div class="min-w-0 flex-1">
        <p class="truncate text-[0.82rem] font-semibold">GreenCart Mini Mart</p>
        <p class="mt-0.5 flex items-center gap-1.5 text-[0.6rem] text-paper-faint">
          <span class="size-1.5 rounded-full bg-[var(--accent)]"></span>
          Ward 4 · open till 9:30 pm
        </p>
      </div>
    </div>
    <div class="mt-3 flex items-center gap-2 rounded-lg border border-ink-600 bg-ink-850 px-2.5 py-2">
      <svg viewBox="0 0 16 16" class="size-3 shrink-0 text-paper-faint" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3" stroke-linecap="round"></path>
      </svg>
      <span class="text-[0.68rem] text-paper-faint">Search this shop’s catalogue</span>
    </div>
  </div>

  {/* Catalogue — masked at the bottom so the cut-off row reads as "more below". */}
  <div
    class="relative min-h-0 flex-1 overflow-hidden px-4 py-3"
    style="mask-image: linear-gradient(to bottom, #000 82%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent 100%);"
  >
    <div class="flex gap-1.5 pb-3">
      {
        ['All', 'Staples', 'Dairy', 'Home'].map((chip, i) => (
          <span
            class:list={[
              'rounded-full px-2.5 py-1 text-[0.6rem]',
              i === 0 ? 'bg-paper font-medium text-ink-900' : 'border border-ink-600 text-paper-faint',
            ]}
          >
            {chip}
          </span>
        ))
      }
    </div>

    <div class="flex flex-col gap-2">
      {
        items.map((item, i) => (
          <div
            class="flex items-center gap-2.5 rounded-lg border border-ink-600/60 bg-ink-850/50 p-2"
            data-anim
            style={`animation: row-arrive 0.55s var(--ease-out-expo) both; animation-delay:${200 + i * 120}ms`}
          >
            <span class="size-8 shrink-0 rounded-md bg-ink-700"></span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-[0.7rem] font-medium">{item.name}</p>
              <p class="mt-0.5 font-mono text-[0.6rem] tabular-nums text-paper-faint">
                {item.pack} · ₹{item.price}
              </p>
            </div>
            <span
              class:list={[
                'shrink-0 rounded-md px-2 py-1 text-[0.6rem] font-medium',
                item.added ? 'bg-[var(--accent)] text-ink-900' : 'border border-ink-500 text-paper-dim',
              ]}
            >
              {item.added ? 'In bag' : 'Add'}
            </span>
          </div>
        ))
      }
    </div>
  </div>

  {/* Bag bar */}
  <div class="border-t border-ink-600/70 bg-ink-850 px-4 py-3">
    <div class="mb-2.5 flex gap-1.5">
      <span class="flex-1 rounded-md bg-ink-700 px-2 py-1.5 text-center text-[0.6rem] font-medium text-paper">Pickup</span>
      <span class="flex-1 rounded-md px-2 py-1.5 text-center text-[0.6rem] text-paper-faint">Delivery</span>
    </div>
    <div class="flex items-center justify-between gap-3 rounded-lg bg-[var(--accent)] px-3 py-2.5">
      <div class="min-w-0 text-ink-900">
        <p class="font-mono text-[0.58rem] font-medium opacity-70">3 items in bag</p>
        <p class="font-mono text-[0.85rem] font-bold tabular-nums">₹447</p>
      </div>
      <span class="shrink-0 text-[0.7rem] font-semibold text-ink-900">Place order →</span>
    </div>
  </div>
</div>
