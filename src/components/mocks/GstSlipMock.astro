---
const fields = [
  { key: 'Seller GSTIN', value: '08ABCDE1234F1Z5' },
  { key: 'Invoice no.', value: 'ST/2026/0148' },
  { key: 'Invoice date', value: '2026-09-04' },
  { key: 'Place of supply', value: 'Rajasthan (08)' },
  { key: 'Taxable value', value: '₹12,400.00' },
  { key: 'CGST 9%', value: '₹1,116.00' },
  { key: 'SGST 9%', value: '₹1,116.00' },
  { key: 'Invoice total', value: '₹14,632.00' },
];

const lines = [
  { d: 'Sunflower Oil 1 L × 40', hsn: '1512', amt: '5,120.00' },
  { d: 'Wheat Flour 10 kg × 12', hsn: '1101', amt: '4,140.00' },
  { d: 'Toor Dal 30 kg', hsn: '0713', amt: '3,140.00' },
];
---

<div class="grid min-h-[24rem] gap-0 @[40rem]:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] @[34rem]:min-h-[28rem]">
  {/* The photograph */}
  <div class="relative flex items-center justify-center overflow-hidden border-b border-ink-600/70 bg-ink-850/70 p-5 @[40rem]:border-b-0 @[40rem]:border-r">
    <div class="relative w-full max-w-[15rem] rotate-[-1.4deg] rounded-sm bg-paper p-3.5 text-ink-900 shadow-[0_18px_45px_-16px_rgba(0,0,0,0.85)]">
      <p class="font-mono text-[0.5rem] uppercase tracking-[0.18em] text-ink-500">Tax invoice</p>
      <p class="mt-1 text-[0.78rem] font-bold">Shree Traders</p>
      <p class="font-mono text-[0.52rem] text-ink-500">GSTIN 08ABCDE1234F1Z5</p>

      <div class="mt-2.5 flex justify-between border-t border-ink-900/15 pt-1.5 font-mono text-[0.52rem]">
        <span>ST/2026/0148</span><span>04-09-2026</span>
      </div>

      <table class="mt-2 w-full border-collapse font-mono text-[0.5rem]">
        <thead>
          <tr class="border-b border-ink-900/20 text-left text-ink-500">
            <th class="pb-1 font-medium">Description</th>
            <th class="pb-1 font-medium">HSN</th>
            <th class="pb-1 text-right font-medium">Amount</th>
          </tr>
        </thead>
        <tbody>
          {
            lines.map((l) => (
              <tr class="border-b border-ink-900/10">
                <td class="max-w-[6.5rem] truncate py-1 pr-1">{l.d}</td>
                <td class="py-1">{l.hsn}</td>
                <td class="py-1 text-right tabular-nums">{l.amt}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="mt-2 space-y-0.5 font-mono text-[0.52rem] tabular-nums">
        <div class="flex justify-between"><span>Taxable</span><span>12,400.00</span></div>
        <div class="flex justify-between"><span>CGST 9%</span><span>1,116.00</span></div>
        <div class="flex justify-between"><span>SGST 9%</span><span>1,116.00</span></div>
        <div class="mt-1 flex justify-between border-t border-ink-900/25 pt-1 text-[0.6rem] font-bold">
          <span>Total</span><span>₹14,632.00</span>
        </div>
      </div>

      <div class="mt-2.5 flex items-end justify-between gap-2 border-t border-ink-900/15 pt-2">
        <p class="font-mono text-[0.44rem] leading-tight text-ink-500">
          IRN<br />a3f9…e21c
        </p>
        <div class="grid size-9 shrink-0 grid-cols-4 grid-rows-4 gap-px" aria-hidden="true">
          {
            Array.from({ length: 16 }).map((_, i) => (
              <span class:list={[[0, 1, 3, 4, 6, 7, 9, 10, 12, 13, 15].includes(i) ? 'bg-ink-900' : 'bg-transparent']} />
            ))
          }
        </div>
      </div>

      {/* Capture sweep */}
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div
          class="absolute inset-x-0 h-16"
          data-anim
          style="animation: scan-sweep 4.5s ease-in-out infinite; background: linear-gradient(to bottom, transparent, color-mix(in oklab, var(--accent) 38%, transparent), transparent);"
        >
        </div>
      </div>
    </div>

    <span class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full border border-ink-600 bg-ink-900/85 px-2.5 py-1 font-mono text-[0.52rem] text-paper-faint">
      4 pages · same invoice
    </span>
  </div>

  {/* The register row it becomes */}
  <div class="flex min-w-0 flex-col">
    <div class="flex items-center justify-between gap-3 border-b border-ink-600/70 px-3 py-2.5 @[34rem]:px-4">
      <p class="label-mono text-[0.52rem]">Extracted fields</p>
      <span class="flex items-center gap-1.5 rounded-full border border-[var(--accent)]/40 bg-[color-mix(in_oklab,var(--accent)_12%,transparent)] px-2 py-0.5 font-mono text-[0.55rem] text-[var(--accent)]">
        <span class="size-1 rounded-full bg-[var(--accent)]"></span> reading
      </span>
    </div>

    <div class="flex-1 p-3 @[34rem]:p-4">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-0 @[28rem]:grid-cols-2">
        {
          fields.map((f, i) => (
            <div
              class="flex items-baseline justify-between gap-3 border-b border-ink-600/40 py-1.5"
              data-anim
              style={`animation: field-lock 0.7s var(--ease-out-expo) both; animation-delay:${200 + i * 140}ms`}
            >
              <dt class="shrink-0 text-[0.63rem] text-paper-faint">{f.key}</dt>
              <dd class="min-w-0 truncate font-mono text-[0.66rem] font-medium tabular-nums">{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-3 rounded-lg border border-ink-600/60 bg-ink-850/50 p-2.5">
        <p class="label-mono text-[0.5rem]">Register · 1 row ready</p>
        <div class="mt-2 flex items-center gap-2">
          <span class="min-w-0 flex-1 truncate font-mono text-[0.62rem] text-paper-dim">
            Shree Traders · ST/2026/0148 · ₹14,632.00
          </span>
          <span class="shrink-0 rounded bg-[var(--accent)] px-2 py-1 text-[0.58rem] font-semibold text-ink-900">CSV</span>
          <span class="shrink-0 rounded border border-ink-500 px-2 py-1 text-[0.58rem] text-paper-dim">Tally XML</span>
        </div>
      </div>

      <p class="mt-3 text-[0.6rem] leading-relaxed text-paper-faint">
        Missing header fields fall back to your defaults. Fields stay on the device until you export.
      </p>
    </div>
  </div>
</div>
