---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { ventures } from '../data/site';

const accentVar = {
  mint: 'var(--color-mint)',
  violet: 'var(--color-violet)',
  amber: 'var(--color-amber)',
} as const;
---

<section id="building" class="scroll-mt-20 border-t border-ink-600/70 py-16 sm:py-24 lg:py-28">
  <div class="container-page">
    <SectionHead
      index="01"
      label="Building now"
      title="Three products, and what each one refuses to be."
      note="Status is a fact, not a pitch: LIVE means a URL you can open today."
    />

    <div class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-600/70 sm:mt-14 lg:grid-cols-3">
      {
        ventures.map((v, i) => (
          <article
            id={v.id}
            class="group relative flex scroll-mt-24 flex-col bg-ink-900 p-6 transition-colors duration-500 hover:bg-ink-850 sm:p-8"
            style={`--accent: ${accentVar[v.accent]}; --reveal-delay:${i * 90}ms`}
            data-reveal
          >
            {/* Accent wash that lifts on hover — the only motion on the card. */}
            <span
              class="pointer-events-none absolute inset-x-0 top-0 h-32 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
              style="background: linear-gradient(to bottom, color-mix(in oklab, var(--accent) 12%, transparent), transparent);"
              aria-hidden="true"
            />

            <div class="relative flex items-center justify-between gap-3">
              <span class="label-mono" style="color: var(--accent)">
                {v.index}
              </span>
              <StatusChip status={v.status} />
            </div>

            <h3 class="relative mt-5 font-display text-sub" style="color: var(--accent)">
              {v.name}
            </h3>
            <p class="label-mono relative mt-2 text-[0.6rem]">{v.kind}</p>

            <p class="relative mt-4 text-body text-paper-dim">{v.what}</p>

            <blockquote
              class="relative mt-5 border-l-2 pl-4 text-fine leading-relaxed text-paper-dim"
              style="border-color: var(--accent)"
            >
              {v.guardrail}
            </blockquote>

            <div class="relative mt-auto pt-7">
              <a
                href={v.primary.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group/link inline-flex max-w-full items-center gap-2 rounded-full px-4 py-2.5 text-fine font-semibold text-ink-900 transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0"
                style="background: var(--accent)"
              >
                <span class="truncate">{v.primary.label}</span>
                <svg viewBox="0 0 16 16" class="size-3 shrink-0 opacity-70 transition-transform duration-300 group-hover/link:-translate-y-0.5 group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
                {v.surfaces.map((s) => (
                  <li>
                    <a
                      href={s.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="label-mono transition-colors duration-200 hover:text-paper"
                    >
                      {s.label} ↗
                    </a>
                  </li>
                ))}
              </ul>

              {v.note && <p class="label-mono mt-4 text-[0.55rem]">{v.note}</p>}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
