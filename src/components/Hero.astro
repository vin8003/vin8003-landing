---
import { person, liveLinks } from '../data/site';
import StatusChip from './StatusChip.astro';

// The claim is split so each line can reveal from behind its own mask.
const claimLines = [
  { text: 'I build products', tint: '' },
  { text: 'with AI.', tint: 'text-ember' },
];
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col justify-center overflow-hidden pb-16 pt-24 sm:pt-28"
  data-hero
>
  {/* Substrate + light */}
  <div class="grid-substrate pointer-events-none absolute inset-0 -z-20"></div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-70 transition-opacity duration-700"
    style="background: radial-gradient(46rem 34rem at var(--px, 50%) var(--py, 22%), color-mix(in oklab, var(--color-ember) 15%, transparent), transparent 70%);"
    data-spotlight
  >
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-64 bg-gradient-to-b from-transparent to-ink-900"
  >
  </div>

  <div class="container-page">
    {/* Instrument row — the command-center readout. */}
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
      <span class="flex items-center gap-2">
        <span class="relative flex size-1.5">
          <span class="absolute inset-0 rounded-full bg-mint" data-anim style="animation: soft-pulse 2.4s ease-in-out infinite;"></span>
          <span class="relative size-1.5 rounded-full bg-mint"></span>
        </span>
        <span class="label-mono text-paper-dim">Building now</span>
      </span>
      <span class="hidden h-3 w-px bg-ink-500 sm:block"></span>
      <span class="label-mono">{person.location}</span>
      <span class="hidden h-3 w-px bg-ink-500 sm:block"></span>
      <span class="label-mono hidden sm:inline">Public command center</span>
    </div>

    {/* Banner: wordmark over the thesis line. */}
    <div class="mt-7 sm:mt-9" data-reveal style="--reveal-delay:60ms">
      <p class="font-mono text-mark font-semibold text-paper">
        <span class="reveal-line"><span>VINEET SHARMA</span></span>
      </p>
      <div class="rule-draw mt-3 h-px w-full origin-left bg-ink-500" style="--reveal-delay:220ms"></div>
      <p class="label-mono mt-3 text-ember sm:text-right">{person.thesisLine}</p>
    </div>

    {/*
      Claim, live rail, buttons. On desktop the rail sits to the right of the
      opener; on mobile it slots between the bio and the buttons, so the live
      product links land directly under the opener instead of last.
    */}
    <div class="mt-10 grid gap-8 sm:mt-14 lg:grid-cols-12 lg:items-start lg:gap-x-14 lg:gap-y-10">
      <div class="min-w-0 lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <h1
          class="font-display text-hero"
          aria-label={person.claim}
          data-reveal
          style="--reveal-delay:120ms"
        >
          {
            claimLines.map((line, i) => (
              <span class="reveal-line" style={`--reveal-delay:${160 + i * 90}ms`}>
                <span class={line.tint}>{line.text}</span>
              </span>
            ))
          }
        </h1>

        <p class="mt-6 max-w-xl text-lead text-paper-dim sm:mt-8" data-reveal style="--reveal-delay:240ms">
          Builder and founder. Dad of two, in Delhi NCR, India. Ten years of Python and Django across
          embedded sensors, fintech, banking, medical systems and casino gaming — now spent shipping my own
          products end to end.
        </p>
      </div>

      <nav
        class="rounded-2xl border border-ink-600/80 bg-ink-850/50 p-4 sm:p-5 lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1"
        aria-label="Live demos and apps"
        data-reveal
        style="--reveal-delay:180ms"
      >
        <div class="flex items-baseline justify-between gap-3">
          <p class="label-mono text-paper-dim">Open right now</p>
          <p class="label-mono text-[0.55rem]">{liveLinks.length} links</p>
        </div>
        <ul class="mt-3 flex flex-col gap-1">
          {
            liveLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between gap-3 rounded-xl px-2 py-2.5 transition-colors duration-200 hover:bg-ink-800/80"
                  style={'dot' in link && link.dot ? `--accent: var(--color-${link.dot.replace('bg-', '')})` : undefined}
                >
                  <span class="flex min-w-0 items-center gap-2.5">
                    {'dot' in link && link.dot ? (
                      <span class={`size-1.5 shrink-0 rounded-full ${link.dot}`} />
                    ) : (
                      <span class="size-1.5 shrink-0 rounded-full bg-paper-faint/60" />
                    )}
                    <span class="min-w-0">
                      <span class="block truncate text-body font-medium text-paper">{link.label}</span>
                      <span class="block truncate text-fine text-paper-faint">{link.note}</span>
                    </span>
                  </span>
                  <span class="flex shrink-0 items-center gap-2">
                    <StatusChip status={link.status} class="hidden sm:inline-flex" />
                    <svg viewBox="0 0 16 16" class="size-3.5 shrink-0 text-paper-faint transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                      <path d="M5 11 11 5M6 5h5v5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="label-mono mt-4 border-t border-ink-600/70 pt-3 text-[0.55rem] leading-relaxed">
          Seed data · guided demos · no invented metrics
        </p>
      </nav>

      <div
        class="flex flex-wrap gap-2.5 sm:gap-3 lg:col-span-7 lg:col-start-1 lg:row-start-2 lg:self-start"
        data-reveal
        style="--reveal-delay:300ms"
      >
        <a
          href="#building"
          class="group inline-flex items-center gap-2 rounded-full bg-paper px-5 py-3 text-body font-medium text-ink-900 transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0 sm:px-6"
        >
          What is building now
          <svg viewBox="0 0 16 16" class="size-3.5 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M8 2.5v11M3.5 9.5 8 14l4.5-4.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href="#log"
          class="inline-flex items-center gap-2 rounded-full border border-ink-500 px-5 py-3 text-body font-medium text-paper transition-colors duration-200 hover:bg-ink-800 sm:px-6"
        >
          Build log
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Pointer-tracked light. Fine pointers only — no cost on touch devices.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const spotlight = document.querySelector<HTMLElement>('[data-spotlight]');
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && spotlight && finePointer && !reduced) {
    let frame = 0;
    hero.addEventListener(
      'pointermove',
      (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const rect = hero.getBoundingClientRect();
          spotlight.style.setProperty('--px', `${((event.clientX - rect.left) / rect.width) * 100}%`);
          spotlight.style.setProperty('--py', `${((event.clientY - rect.top) / rect.height) * 100}%`);
        });
      },
      { passive: true },
    );
  }
</script>
