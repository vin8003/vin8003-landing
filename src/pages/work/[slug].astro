---
import { ArrowLeft, ArrowUpRight } from 'lucide-react';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Frame from '../../components/Frame.astro';
import { cases, caseHref, type CaseStudy } from '../../data/cases';
import { demos, demoMedia } from '../../data/demos';
import { person } from '../../data/site';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.id }, props: { c } }));
}

interface Props {
  c: CaseStudy;
}

const { c } = Astro.props;
const i = cases.indexOf(c);
const next = cases[(i + 1) % cases.length];

const shot = (id: string, image: string) => {
  const demo = demos.find((d) => d.id === id)!;
  const step = demo.steps.find((st) => st.image === image);
  return step ? demoMedia(demo, step) : null;
};
const shots = c.shots.map((s) => ({ ...s, src: shot(s.demo, s.image), phone: s.demo === 'customer' })).filter((s) => s.src);
---

<Base title={`${c.name} case study - vin8003.com`} description={`${c.dek} ${c.role}`} skipTo="#case">
  <Nav home={false} />

  <main>
    <article id="case" class="relative isolate overflow-hidden pb-16 pt-28 sm:pb-24 sm:pt-36" data-atmos={c.accent} data-atmos-intensity="0.55" style={`--accent: var(--color-${c.accent})`}>
      <div class="container-page">
        <div class="mx-auto max-w-3xl">
          <a href={`/#${c.id}`} class="label-mono gap-1.5 transition-colors hover:text-paper"><ArrowLeft className="size-3.5" strokeWidth={1.7} aria-hidden="true" />vin8003.com</a>
          <p class="label-mono mt-8" style="color: var(--accent)">Case study · {c.kind}</p>
          <h1 class="mt-5 font-display text-title" style="color: var(--accent)">{c.name}</h1>
          <p class="mt-5 text-lead text-paper-dim">{c.dek}</p>
          <div class="mt-7 flex flex-wrap gap-2.5">
            {
              c.live.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-fine font-semibold text-ink-900" style="background: var(--accent);">
                  {l.label}
                  <ArrowUpRight className="size-3 opacity-70" strokeWidth={1.8} aria-hidden="true" />
                </a>
              ))
            }
            <a href={c.demo} class="inline-flex items-center gap-2 rounded-full border border-ink-500 px-4 py-2.5 text-fine text-paper transition-colors hover:border-paper-dim">Walk the demo</a>
          </div>
        </div>

        {
          shots[0] && (
            <figure class="line-reveal mx-auto mt-12 max-w-5xl" data-reveal>
              <Frame variant={shots[0].phone ? 'phone' : 'browser'}>
                <img src={shots[0].src} alt={shots[0].alt} width="2160" height="1350" class="block h-auto w-full" />
              </Frame>
            </figure>
          )
        }

        <div class="mx-auto mt-14 flex max-w-3xl flex-col gap-14">
          <section>
            <h2 class="font-display text-sub text-paper">The problem</h2>
            {c.problem.map((p) => <p class="mt-5 text-lead text-paper-dim">{p}</p>)}
          </section>

          <section class="grid gap-px overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-600/70 sm:grid-cols-2">
            <div class="bg-ink-900 p-5 sm:p-6">
              <p class="label-mono">My part</p>
              <p class="mt-3 text-fine leading-relaxed text-paper">{c.role}</p>
            </div>
            <div class="bg-ink-900 p-5 sm:p-6">
              <p class="label-mono">Built with</p>
              <ul class="mt-3 space-y-1 text-fine text-paper">{c.stack.map((s) => <li>{s}</li>)}</ul>
            </div>
          </section>

          <section>
            <h2 class="font-display text-sub text-paper">What I built</h2>
            <ol class="mt-6 flex flex-col">
              {
                c.built.map((b) => (
                  <li class="flex flex-col gap-1.5 border-t border-ink-600/70 py-4 first:border-t-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                    <span class="text-body text-paper-dim">{b.line}</span>
                    <a href={b.link.href} target="_blank" rel="noopener noreferrer" class="label-mono shrink-0 text-[0.62rem] transition-colors hover:text-paper">{b.link.label} ↗</a>
                  </li>
                ))
              }
            </ol>
          </section>

          {
            shots.length > 1 && (
              <div class="grid gap-4 sm:grid-cols-2 sm:-mx-10 lg:-mx-24">
                {shots.slice(1).map((s) => (
                  <figure class="overflow-hidden rounded-2xl border border-ink-600/70">
                    <img src={s.src} alt={s.alt} width="2160" height="1350" loading="lazy" decoding="async" class="block h-auto w-full" />
                    <figcaption class="label-mono bg-ink-900 px-4 py-3 text-[0.6rem]">{s.alt}</figcaption>
                  </figure>
                ))}
              </div>
            )
          }

          <section>
            <h2 class="font-display text-sub text-paper">Calls I made</h2>
            <div class="mt-6 flex flex-col gap-4">
              {
                c.calls.map((k) => (
                  <div class="rounded-2xl border border-ink-600/80 bg-ink-850/50 p-5 sm:p-6">
                    <h3 class="text-body font-semibold" style="color: var(--accent)">{k.title}</h3>
                    <p class="mt-2 text-body text-paper-dim">{k.body}</p>
                    {k.link && (
                      <a href={k.link.href} target="_blank" rel="noopener noreferrer" class="label-mono mt-3 inline-block text-[0.62rem] transition-colors hover:text-paper">{k.link.label} ↗</a>
                    )}
                  </div>
                ))
              }
            </div>
          </section>

          {
            c.outcomes.length > 0 && (
              <section>
                <h2 class="font-display text-sub text-paper">What happened</h2>
                <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-600/70 sm:grid-cols-3">
                  {c.outcomes.map((o) => (
                    <div class="bg-ink-900 p-5">
                      <dd class="font-display text-sub" style="color: var(--accent)">{o.value}</dd>
                      <dt class="label-mono mt-2">{o.label}</dt>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }

          <p class="border-t border-ink-600/70 pt-6 font-mono text-[0.68rem] leading-relaxed text-paper-faint">
            Every line above links to the merged pull request or commit it describes. Screens are real captures on seed data. {person.name}.
          </p>

          <a href={caseHref(next.id)} class="group flex items-baseline justify-between gap-4 rounded-2xl border border-ink-600/70 p-5 transition-colors hover:border-paper-dim sm:p-6">
            <span class="label-mono">Next case study</span>
            <span class="font-display text-sub" style={`color: var(--color-${next.accent})`}>{next.name} →</span>
          </a>
        </div>
      </div>
    </article>

    <Footer />
  </main>
</Base>
