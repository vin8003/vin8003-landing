---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { thesis, stack } from '../data/site';
---

<section id="thesis" class="relative scroll-mt-20 overflow-hidden py-16 sm:py-24 lg:py-28">
  <div class="grid-substrate pointer-events-none absolute inset-0 opacity-60 [mask-image:linear-gradient(to_bottom,transparent,#000_25%,#000_75%,transparent)]"></div>
  <div class="aurora" aria-hidden="true">
    <span class="left-[5%] top-0 h-[26rem] w-[40rem]" style="background: var(--color-ember); opacity: 0.22"></span>
  </div>

  <div class="container-page relative">
    <SectionHead index="04" label="Thesis" title="One job each." />

    <blockquote class="mt-10 max-w-5xl sm:mt-14" data-reveal>
      <p class="font-display text-title text-paper">
        <span class="reveal-line"><span><span class="text-gradient">“</span>{thesis.line}</span></span>
      </p>
    </blockquote>

    {/* The roster: each product as the job it holds. */}
    <ol class="mt-12 grid gap-4 sm:mt-16 md:grid-cols-3">
      {
        thesis.roster.map((r, i) => (
          <li
            class="spot ring-gradient group relative flex flex-col overflow-hidden rounded-3xl bg-ink-850/70 p-6 sm:p-7"
            style={`--accent: var(--color-${r.accent}); --reveal-delay:${i * 90}ms`}
            data-reveal
            data-spot
          >
            <span
              class="pointer-events-none absolute -right-6 -top-10 font-display text-[9rem] leading-none opacity-[0.07] transition-opacity duration-500 group-hover:opacity-[0.14]"
              style="color: var(--accent)"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="relative grid size-11 place-items-center rounded-2xl font-mono text-sm font-bold text-ink-900" style="background: var(--accent); box-shadow: 0 10px 30px -10px var(--accent)">
              {r.name[0]}
            </span>
            <p class="label-mono relative mt-6" style="color: var(--accent)">{r.role}</p>
            <p class="relative mt-2 font-display text-sub text-paper">{r.name}</p>
            <p class="relative mt-3 text-fine leading-relaxed text-paper-dim">{r.job}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-12 lg:gap-14">
      <div class="flex flex-col gap-6 text-lead text-paper-dim lg:col-span-7">
        {
          thesis.body.map((para, i) => (
            <p data-reveal style={`--reveal-delay:${i * 70}ms`}>
              {para}
            </p>
          ))
        }
      </div>

      <aside class="flex flex-col gap-3 lg:col-span-5">
        <div class="rounded-2xl border border-dashed border-ink-500/80 bg-ink-850/40 p-5 sm:p-6" data-reveal style="--reveal-delay:120ms">
          <div class="flex items-center justify-between gap-3">
            <p class="label-mono">Waiting in the wings</p>
            <StatusChip status={thesis.parked.status} />
          </div>
          <p class="mt-4 font-display text-sub text-paper">{thesis.parked.name}</p>
          <p class="mt-3 text-fine leading-relaxed text-paper-dim">{thesis.parked.note}</p>
        </div>

        <div class="glass rounded-2xl p-5 sm:p-6" data-reveal style="--reveal-delay:180ms">
          <p class="label-mono">What the assistants are built with</p>
          <dl class="mt-5 flex flex-col gap-4">
            {
              stack.map((group) => (
                <div class="border-t border-ink-600/60 pt-4 first:border-t-0 first:pt-0">
                  <dt class="text-fine text-paper-faint">{group.group}</dt>
                  <dd class="mt-2 flex flex-wrap gap-1.5">
                    {group.items.map((item) => (
                      <span class="rounded-full border border-ink-500/80 bg-ink-800 px-3 py-1 font-mono text-[0.68rem] text-paper">
                        {item}
                      </span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
