---
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Where the skip link lands. */
  skipTo?: string;
  /** Play the loading ring on the first visit of a session. */
  intro?: boolean;
}

const {
  title = 'vin8003 - I build products with AI',
  description = `${person.name}, builder and founder in Delhi NCR. ${person.thesisLine} Building OrderEasy, CiteBench and GSTSlip.`,
  skipTo = '#building',
  intro = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://vin8003.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/fraunces-soft.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <meta name="theme-color" content="#08080a" />
    <meta name="author" content={person.name} />


    {/* First visit in a session gets the loading ring. Decided before paint so nothing flashes. */}
    {
      intro && (
        <script is:inline>
          (() => {
            try {
              if (sessionStorage.getItem('vin8003-intro')) return;
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
              sessionStorage.setItem('vin8003-intro', '1');
              document.documentElement.setAttribute('data-intro', '');
            } catch {
              /* storage blocked: skip the intro */
            }
          })();
        </script>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site ?? 'https://vin8003.com').href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="vin8003.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@vin8003" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: person.name,
        url: 'https://vin8003.com',
        email: `mailto:${person.email}`,
        jobTitle: 'Builder & founder',
        description: person.tagline,
        address: { '@type': 'PostalAddress', addressRegion: 'Delhi NCR', addressCountry: 'IN' },
        sameAs: ['https://x.com/vin8003', 'https://www.linkedin.com/in/vin8003', 'https://github.com/vin8003'],
      })}
    />
  </head>
  <body class="grain">
    <canvas class="clouds" aria-hidden="true" data-clouds-canvas></canvas>
    {
      intro && (
        <div class="intro" aria-hidden="true" data-intro-screen>
          <p class="hud-label absolute left-5 top-6 text-paper sm:left-10 sm:top-8">
            vin8003.com
            <br />
            <span class="text-paper-faint">{person.name}</span>
          </p>
          <div class="relative grid size-[min(22rem,64vw)] place-items-center">
            <svg class="intro-ring absolute inset-0 size-full -rotate-90" viewBox="0 0 100 100" fill="none">
              <circle cx="50" cy="50" r="48" stroke="currentColor" stroke-opacity="0.35" stroke-width="0.25" stroke-dasharray="0.6 0.9" class="text-paper" />
              <circle cx="50" cy="50" r="49.2" stroke="currentColor" stroke-width="0.35" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" class="text-paper" data-intro-arc />
            </svg>
            <p class="font-mono text-[0.85rem] tabular-nums text-paper" data-intro-count>0%</p>
          </div>
          <p class="hud-label absolute bottom-6 right-5 sm:bottom-8 sm:right-10">Loading the index</p>
        </div>
      )
    }
    <a
      href={skipTo}
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[110] focus:rounded-full focus:bg-ember focus:px-5 focus:py-2.5 focus:text-fine focus:font-medium focus:text-white"
    >
      Skip to content
    </a>
    <slot />

    <script>
      import '../scripts/motion';
      import { mountClouds } from '../scripts/clouds';
      import { playIntro } from '../scripts/intro';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const cloudCanvas = document.querySelector<HTMLCanvasElement>('[data-clouds-canvas]');
      if (cloudCanvas) {
        try {
          mountClouds(cloudCanvas);
        } catch {
          /* no WebGL: the plain ink sheet stays */
        }
      }

      // Reveal on scroll. Elements stay revealed once seen; nothing starts until the intro clears.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const startReveals = () => {
        // The first screen is all seen at once; its own delays stagger it.
        document.querySelectorAll<HTMLElement>('[data-hero] [data-reveal]').forEach((el) => el.classList.add('is-revealed'));
        if (reduced) {
          revealables.forEach((el) => el.classList.add('is-revealed'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
          );
          revealables.forEach((el) => io.observe(el));
        }
      };
      void playIntro().then(startReveals);

      // Mock UIs only animate while visible, so idle pages cost nothing.
      const mocks = document.querySelectorAll<HTMLElement>('[data-mock]');
      if (mocks.length && !reduced) {
        const mockIo = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('mock-live', entry.isIntersecting);
            }
          },
          { threshold: 0.15 },
        );
        mocks.forEach((el) => mockIo.observe(el));
      }

      // The section the reader is in stays lit in both navs.
      const links = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
      const sections = [...links]
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((el): el is HTMLElement => Boolean(el));

      if (sections.length) {
        const spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              for (const link of links) {
                link.toggleAttribute('data-current', link.hash === `#${entry.target.id}`);
              }
            }
          },
          { rootMargin: '-45% 0px -50% 0px' },
        );
        sections.forEach((el) => spy.observe(el));
      }
    </script>
  </body>
</html>
