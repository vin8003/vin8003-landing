---
import SectionHead from './SectionHead.astro';
import { about, person, socials } from '../data/site';

const x = socials.find((s) => s.label === 'X')!;
---

<section id="about" class="scroll-mt-20 border-t border-ink-600/70 py-16 sm:py-24 lg:py-28">
  <div class="container-page">
    <SectionHead index="05" label="About" title="Short version." />

    <div class="mt-10 grid gap-10 sm:mt-14 lg:grid-cols-12 lg:gap-14">
      <div class="flex flex-col gap-6 text-lead text-paper-dim lg:col-span-7">
        {
          about.lines.map((line, i) => (
            <p data-reveal style={`--reveal-delay:${i * 70}ms`}>
              {line}
            </p>
          ))
        }
        <p data-reveal style="--reveal-delay:210ms">
          <a
            href={x.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-paper underline decoration-ember decoration-2 underline-offset-4 transition-colors duration-200 hover:text-ember"
            >{x.handle}</a
          > is a lab notebook, not a brand channel. Progress, dead ends and the occasional rewrite go up as
          they happen.
        </p>
      </div>

      <aside class="flex flex-col gap-3 lg:col-span-5" data-reveal style="--reveal-delay:120ms">
        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-600/70">
          {
            [
              { k: 'Based', v: person.location },
              { k: 'Home', v: 'Dad of two' },
              { k: 'Writes', v: 'Python · Django · TypeScript' },
              { k: 'Ships to', v: 'Cloudflare' },
            ].map((row) => (
              <div class="flex flex-col justify-between gap-4 bg-ink-900 p-4 sm:p-5">
                <dt class="label-mono">{row.k}</dt>
                <dd class="text-fine text-paper">{row.v}</dd>
              </div>
            ))
          }
        </dl>

        <p class="rounded-2xl border border-ink-600/80 bg-ink-850/50 p-5 text-fine leading-relaxed text-paper-dim sm:p-6">
          {about.dayRole}
        </p>
      </aside>
    </div>
  </div>
</section>
