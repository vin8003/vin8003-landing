---
import SectionHead from './SectionHead.astro';
import DemoPlayer from './DemoPlayer.astro';
import { demos } from '../data/demos';
import { ArrowRight } from 'lucide-react';

const totalSteps = demos.reduce((n, d) => n + d.steps.length, 0);
---

<section id="demo" class="relative scroll-mt-20 overflow-clip py-16 sm:py-24 lg:py-28">
  <div class="grid-substrate pointer-events-none absolute inset-0 -z-10 opacity-70 [mask-image:linear-gradient(to_bottom,transparent,#000_20%,#000_80%,transparent)]"></div>

  <div class="container-page relative">
    <SectionHead
      title="Walk the product before anyone asks you to sign up."
      note={`Four guided journeys, ${totalSteps} real screens, right here on the page. Every screen is a capture of the product running on seed data. Click one to see it full size, or use the arrow keys.`}
    />

    <div class="mt-10 sm:mt-14" data-reveal style="--reveal-delay:120ms">
      <DemoPlayer />
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2" data-reveal>
      <a href="/demo/" class="group inline-flex items-center gap-2 text-fine font-medium text-paper transition-colors hover:text-ember">
        Open the demos on their own page
        <ArrowRight className="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5" strokeWidth={1.7} aria-hidden="true" />
      </a>
      <span class="text-fine text-paper-faint">No sign-up, no fake UIs, seed data only.</span>
    </div>
  </div>
</section>
