---
const rail = ['Today', 'Diary', 'Matters', 'Research', 'Authorities', 'Inbox'];

const authorities = [
  { case: 'Kesavananda Bharati v. State of Kerala', court: 'Supreme Court of India', year: '1973', note: 'Basic structure of the Constitution.' },
  { case: 'Maneka Gandhi v. Union of India', court: 'Supreme Court of India', year: '1978', note: 'Procedure established by law must be fair.' },
  { case: 'K. S. Puttaswamy v. Union of India', court: 'Supreme Court of India', year: '2017', note: 'Privacy as a fundamental right.' },
  { case: 'Vishaka v. State of Rajasthan', court: 'Supreme Court of India', year: '1997', note: 'Guidelines in the absence of legislation.' },
];
---

<div class="flex min-h-[24rem] text-[0.7rem] @[34rem]:min-h-[28rem]">
  <aside class="hidden w-36 shrink-0 flex-col gap-0.5 border-r border-ink-600/70 bg-ink-850/60 p-2.5 @[40rem]:flex">
    <div class="mb-2 px-1.5">
      <p class="label-mono text-[0.5rem]">Chamber</p>
      <p class="mt-1 truncate text-[0.72rem] font-semibold">Sharma &amp; Co.</p>
    </div>
    {
      rail.map((item) => (
        <span
          class:list={[
            'truncate rounded-md px-2 py-1.5 text-[0.68rem]',
            item === 'Research' ? 'bg-ink-700 font-medium text-paper' : 'text-paper-faint',
          ]}
        >
          {item}
        </span>
      ))
    }
    <span class="mt-auto rounded-md border border-ink-600 px-2 py-1.5 text-center font-mono text-[0.55rem] text-paper-faint">
      EN · हिं
    </span>
  </aside>

  <div class="flex min-w-0 flex-1 flex-col">
    {/* Query */}
    <div class="border-b border-ink-600/70 p-3 @[34rem]:p-4">
      <p class="label-mono text-[0.52rem]">Research · facts, legal question, court</p>
      <div class="mt-2.5 grid gap-2 @[34rem]:grid-cols-[1fr_auto]">
        <div class="rounded-lg border border-ink-600 bg-ink-850 p-2.5">
          <p class="text-[0.72rem] leading-relaxed text-paper">
            Whether a statutory procedure that limits personal liberty must independently satisfy fairness
            <span
              class="ml-0.5 inline-block h-[0.85em] w-[1.5px] translate-y-[0.12em] bg-[var(--accent)] align-middle"
              data-anim
              style="animation: caret-blink 1.1s steps(1) infinite;"></span>
          </p>
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {
              ['Constitutional', 'Supreme Court', 'Since 1970'].map((chip) => (
                <span class="rounded-full border border-ink-500 px-2 py-0.5 font-mono text-[0.55rem] text-paper-faint">
                  {chip}
                </span>
              ))
            }
          </div>
        </div>
        <span class="grid place-items-center rounded-lg bg-[var(--accent)] px-4 py-2 text-[0.7rem] font-semibold text-ink-900">
          Search
        </span>
      </div>
    </div>

    {/* Retrieved authorities */}
    <div class="min-w-0 flex-1 p-3 @[34rem]:p-4">
      <div class="flex items-center justify-between gap-3">
        <p class="label-mono text-[0.52rem]">Authorities retrieved</p>
        <span class="label-mono text-[0.5rem] text-paper-faint">Shown as retrieved · not ranked by outcome</span>
      </div>
      <div class="mt-2.5 flex flex-col gap-2">
        {
          authorities.map((a, i) => (
            <div
              class="rounded-lg border border-ink-600/60 bg-ink-850/50 p-2.5"
              data-anim
              style={`animation: row-arrive 0.6s var(--ease-out-expo) both; animation-delay:${260 + i * 150}ms`}
            >
              <div class="flex items-baseline justify-between gap-3">
                <p class="min-w-0 flex-1 truncate text-[0.73rem] font-medium">{a.case}</p>
                <span class="shrink-0 font-mono text-[0.6rem] tabular-nums text-[var(--accent)]">{a.year}</span>
              </div>
              <p class="mt-1 truncate text-[0.63rem] text-paper-faint">
                {a.court} · {a.note}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* The guardrail, drawn */}
  <aside class="hidden w-56 shrink-0 flex-col border-l border-ink-600/70 bg-ink-850/40 p-3 @[52rem]:flex">
    <p class="label-mono text-[0.52rem]">Directions</p>

    <div class="mt-2.5 rounded-lg border-l-2 border-l-paper bg-ink-800/70 p-2.5">
      <p class="label-mono text-[0.5rem] text-paper">Court direction</p>
      <p class="mt-1.5 text-[0.68rem] leading-relaxed">Reply affidavit to be filed before the next date.</p>
    </div>

    <div class="mt-2 rounded-lg border border-dashed border-[var(--accent)]/50 p-2.5">
      <p class="label-mono text-[0.5rem] text-[var(--accent)]">CiteBench suggestion</p>
      <p class="mt-1.5 text-[0.68rem] leading-relaxed text-paper-dim">
        Consider whether the 2017 authority is relied on in the reply.
      </p>
    </div>

    <p class="mt-3 border-t border-ink-600/50 pt-2.5 text-[0.6rem] leading-relaxed text-paper-faint">
      Two kinds of line, never the same weight. Suggestions are not court directions.
    </p>

    <div class="mt-auto pt-3">
      <p class="label-mono text-[0.5rem]">Diary · today</p>
      <div class="mt-2 flex flex-col gap-1.5">
        {
          [
            { time: '10:30', text: 'Mentioning — Court 4' },
            { time: '14:00', text: 'Client conference' },
          ].map((d) => (
            <div class="flex gap-2">
              <span class="shrink-0 font-mono text-[0.6rem] tabular-nums text-[var(--accent)]">{d.time}</span>
              <span class="min-w-0 truncate text-[0.65rem] text-paper-dim">{d.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </aside>
</div>
