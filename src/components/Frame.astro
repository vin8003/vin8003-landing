---
interface Props {
  variant?: 'browser' | 'phone';
  url?: string;
  caption?: string;
  class?: string;
}

const { variant = 'browser', url, caption, class: className = '' } = Astro.props;
---

{
  variant === 'browser' ? (
    <figure class={`@container overflow-hidden rounded-2xl border border-ink-500/90 bg-ink-850 shadow-frame ${className}`}>
      <div class="flex items-center gap-3 border-b border-ink-600/80 bg-ink-800 px-3 py-2.5 sm:px-4">
        {url && (
          <span class="min-w-0 flex-1 truncate rounded-lg bg-ink-900/70 px-2.5 py-1 text-center font-mono text-[0.62rem] text-paper-faint sm:text-[0.68rem]">
            {url}
          </span>
        )}
      </div>
      <div class="relative bg-ink-900">
        <slot />
      </div>
      {caption && (
        <figcaption class="label-mono border-t border-ink-600/80 bg-ink-850 px-3 py-2.5 text-[0.6rem] sm:px-4">
          {caption}
        </figcaption>
      )}
    </figure>
  ) : (
    <figure class={`mx-auto w-full max-w-[19rem] ${className}`}>
      <div class="@container relative overflow-hidden rounded-2xl border border-ink-500/90 bg-ink-850 p-1.5 shadow-frame sm:p-2">
        <div class="relative overflow-hidden rounded-lg bg-ink-900">
          <slot />
        </div>
      </div>
      {caption && <figcaption class="label-mono mt-3 text-center text-[0.6rem]">{caption}</figcaption>}
    </figure>
  )
}
