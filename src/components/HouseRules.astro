---
import { houseRules } from '../data/site';
---

<section class="relative overflow-hidden border-t border-ink-600/70 bg-ink-850/50 py-16 sm:py-24">
  <div class="grid-substrate pointer-events-none absolute inset-0 opacity-60"></div>

  <div class="container-page relative">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
      <div>
        <p class="label-mono text-ember">06 &nbsp;·&nbsp; House rules</p>
        <h2 class="mt-4 max-w-2xl font-display text-title">
          Lines that ship inside the products, not just in my notes.
        </h2>
      </div>
      <p class="label-mono max-w-xs leading-relaxed">Quoted verbatim from the live surfaces</p>
    </div>

    <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-ink-600/70 bg-ink-600/70 sm:mt-14 sm:grid-cols-2 lg:grid-cols-3">
      {
        houseRules.map((item, i) => (
          <li
            class="group flex min-h-[11rem] flex-col justify-between gap-6 bg-ink-900 p-5 transition-colors duration-300 hover:bg-ink-850 sm:min-h-[13rem] sm:p-7"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <p class="font-display text-[clamp(1.25rem,1.05rem+0.75vw,1.6rem)] leading-[1.25] text-paper">
              <span class="mr-1 text-ember">“</span>
              {item.rule}
            </p>
            <p class="label-mono text-[0.58rem] transition-colors duration-300 group-hover:text-paper-dim">
              {item.source}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
