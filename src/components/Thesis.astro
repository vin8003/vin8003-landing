---
import SectionHead from './SectionHead.astro';
import StatusChip from './StatusChip.astro';
import { thesis, stack } from '../data/site';

// The quote fills in word by word as it scrolls up; --p is each word's share of the way through.
const quoteWords = thesis.line.split(' ');
---

<section id="thesis" class="relative scroll-mt-20 overflow-hidden py-16 sm:py-24 lg:py-28" data-atmos="ember" data-atmos-intensity="0.6">
  <div class="grid-substrate pointer-events-none absolute inset-0 opacity-60 [mask-image:linear-gradient(to_bottom,transparent,#000_25%,#000_75%,transparent)]"></div>

  <div class="container-page relative">
    <SectionHead title="One job each." />

    <blockquote class="ink-quote mt-10 max-w-5xl sm:mt-14" data-reveal>
      <p class="font-display text-title text-paper">
        <span class="text-ember">“</span>{
          quoteWords.map((w, i) => (
            <>
              <span class="ink-word" style={`--p:${(i / Math.max(quoteWords.length - 1, 1)).toFixed(3)}`}>{w}</span>{i < quoteWords.length - 1 && ' '}
            </>
          ))
        }
      </p>
    </blockquote>

    {/* The roster: each product as the job it holds, one row each. */}
    <ol class="mt-12 sm:mt-16" data-reveal>
      {
        thesis.roster.map((r) => (
          <li
            class="sd-depth grid gap-x-8 gap-y-2 border-t border-ink-600/70 py-6 first:border-t-0 md:grid-cols-[minmax(0,14rem)_minmax(0,13rem)_1fr] md:items-baseline"
            style={`--accent: var(--color-${r.accent})`}
          >
            <p class="font-display text-sub text-paper">{r.name}</p>
            <p class="label-mono" style="color: var(--accent)">{r.role}</p>
            <p class="max-w-[65ch] text-body text-paper-dim">{r.job}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 grid gap-10 sm:mt-16 lg:grid-cols-12 lg:gap-14">
      <div class="flex flex-col gap-6 text-lead text-paper-dim lg:col-span-7">
        {
          thesis.body.map((para, i) => (
            <p data-reveal style={`--reveal-delay:${i * 70}ms`}>
              {para}
            </p>
          ))
        }
      </div>

      <aside class="flex flex-col gap-3 lg:col-span-5">
        <div class="relative overflow-hidden rounded-2xl border border-dashed border-ink-500/80 bg-ink-850/40 p-5 sm:p-6" data-reveal data-tilt="5" style="--reveal-delay:120ms">
          <div class="flex items-center justify-between gap-3">
            <p class="label-mono">Waiting in the wings</p>
            <StatusChip status={thesis.parked.status} />
          </div>
          <p class="mt-4 font-display text-sub text-paper">{thesis.parked.name}</p>
          <p class="mt-3 text-fine leading-relaxed text-paper-dim">{thesis.parked.note}</p>
        </div>

        <div class="glass relative overflow-hidden rounded-2xl p-5 sm:p-6" data-reveal data-tilt="4" style="--reveal-delay:180ms">
          <p class="label-mono">What the assistants are built with</p>
          <dl class="mt-5 flex flex-col gap-4">
            {
              stack.map((group) => (
                <div class="border-t border-ink-600/60 pt-4 first:border-t-0 first:pt-0">
                  <dt class="text-fine text-paper-faint">{group.group}</dt>
                  <dd class="mt-2 flex flex-wrap gap-1.5">
                    {group.items.map((item) => (
                      <span class="rounded-full border border-ink-500/80 bg-ink-800 px-3 py-1 font-mono text-[0.68rem] text-paper">
                        {item}
                      </span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
