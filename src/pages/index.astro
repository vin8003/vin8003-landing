---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import ProductSection from '../components/ProductSection.astro';
import Method from '../components/Method.astro';
import HouseRules from '../components/HouseRules.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';

import RetailerMock from '../components/mocks/RetailerMock.astro';
import CustomerMock from '../components/mocks/CustomerMock.astro';
import CiteBenchMock from '../components/mocks/CiteBenchMock.astro';
import GstSlipMock from '../components/mocks/GstSlipMock.astro';

import { products, demoHub } from '../data/site';

const [retailer, customer, citebench, gstslip] = products;
const hubHost = demoHub.replace('https://', '');
---

<Base>
  <Nav />

  <main>
    <Hero />
    <Marquee />

    <div id="work" class="scroll-mt-20 pt-16 sm:pt-24 lg:pt-28">
      <div class="container-page">
        <SectionHead
          label="The work"
          title="Four surfaces, all of them openable right now."
          note="Nothing here is a mockup of a plan. Each one has a guided demo you can walk through, or a live app you can sign into."
        />
      </div>
    </div>

    <div class="mt-14 sm:mt-20">
      <ProductSection
        product={retailer!}
        media="browser"
        frameUrl={`${hubHost}/retailer/`}
        frameCaption="Preview of the retailer surface · seed data"
      >
        <RetailerMock />
      </ProductSection>

      <ProductSection
        product={customer!}
        media="phone"
        frameCaption="Preview of the customer surface · seed data"
      >
        <CustomerMock />
      </ProductSection>

      <ProductSection
        product={citebench!}
        media="browser"
        frameUrl="citebench.ordereasy.win/research"
        frameCaption="Preview of the research desk · sample chamber"
      >
        <CiteBenchMock />
      </ProductSection>

      <ProductSection
        product={gstslip!}
        media="browser"
        frameUrl="gstslip.grok.me"
        frameCaption="Preview of a capture · sample invoice"
      >
        <GstSlipMock />
      </ProductSection>
    </div>

    <Method />
    <HouseRules />
    <About />
    <Footer />
  </main>
</Base>
