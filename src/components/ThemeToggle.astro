---
/**
 * Flips the ink/paper ramps defined in global.css. Preference is remembered;
 * with nothing stored the OS setting wins. The pre-paint script that applies
 * the stored choice lives in Base.astro so there is never a flash.
 */
---

<button
  type="button"
  class="grid size-9 shrink-0 place-items-center rounded-full border border-ink-500 text-paper-dim transition-colors duration-200 hover:border-paper-faint hover:text-paper"
  data-theme-toggle
  aria-label="Switch colour theme"
>
  <span data-theme-icon="dark">
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M20.5 14.3A8.5 8.5 0 1 1 9.7 3.5a7 7 0 0 0 10.8 10.8Z" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
  <span data-theme-icon="light" hidden>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.6v2.2M12 19.2v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.4 19.6 6 18M18 6l1.6-1.6" stroke-linecap="round"></path>
    </svg>
  </span>
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: light)');

  const paint = () => {
    const light = root.dataset.theme === 'light';
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f6f3ec' : '#08080a');
    for (const icon of document.querySelectorAll<HTMLElement>('[data-theme-icon]')) {
      // The button offers the theme you are about to get, not the one you are in.
      icon.hidden = icon.dataset.themeIcon === (light ? 'dark' : 'light');
    }
    for (const button of document.querySelectorAll('[data-theme-toggle]')) {
      button.setAttribute('aria-label', light ? 'Switch to the dark theme' : 'Switch to the light theme');
    }
  };

  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('vin8003-theme', next);
      } catch {
        // Private mode — the choice just does not survive the reload.
      }
      paint();
    });
  }

  // Follow the OS while the visitor has not chosen for themselves.
  media.addEventListener('change', (event) => {
    try {
      if (localStorage.getItem('vin8003-theme')) return;
    } catch {
      /* no storage, keep following the OS */
    }
    root.dataset.theme = event.matches ? 'light' : 'dark';
    paint();
  });

  paint();
</script>
