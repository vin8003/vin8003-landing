---
import { nav, person } from '../data/site';
import ScrollProgress from './islands/ScrollProgress';

interface Props {
  /** Off the front page, section links point back to it. */
  home?: boolean;
}

const { home = true } = Astro.props;
const links = nav.map((item) => ({ ...item, href: home ? item.href : `/${item.href}` }));
---

<ScrollProgress client:load />

{/* Sentinel: when it leaves the viewport the nav gains its solid backdrop. */}
<div class="pointer-events-none absolute left-0 top-0 h-6 w-px" aria-hidden="true" data-nav-sentinel></div>

<header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500"
  data-nav
>
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-[4.5rem]">
    <a href={home ? '#top' : '/'} class="group flex min-w-0 items-center gap-3" aria-label={`${person.name}, home`}>
      <span class="nav-logo grid size-9 shrink-0 place-items-center font-mono text-[0.7rem] font-semibold text-paper">VS</span>
      <span class="flex min-w-0 flex-col gap-1 leading-none">
        <span class="truncate font-mono text-[0.74rem] font-semibold uppercase tracking-[0.16em] text-paper">{person.name}</span>
        <span class="hud-label hidden truncate text-[0.58rem] sm:block">{person.thesisLine}</span>
      </span>
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Sections">
      {
        links.map((item, i) => (
          <a href={item.href} data-section-link class="nav-link hud-label group relative flex items-baseline gap-1.5 px-3 py-2.5 hover:text-paper">
            <span class="nav-mark" aria-hidden="true">▹</span>
            <span class="nav-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="nav-text">{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <p class="hud-label mr-2 hidden items-center gap-2 tabular-nums 2xl:flex">
        <span class="nav-pulse" aria-hidden="true"></span>
        Delhi <time data-nav-clock>--:--</time> IST
      </p>
      <a
        href="https://x.com/vin8003"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-ctl hidden sm:grid"
        aria-label="Vineet Sharma on X"
      >
        <span class="font-mono text-[0.72rem] font-semibold" aria-hidden="true">X</span>
      </a>
      <a href={`mailto:${person.email}`} data-magnetic class="nav-email group">
        <span>Email</span>
        <span class="nav-email-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

{/* Thumb-reach nav for tall phone screens. */}
<nav
  class="fixed inset-x-0 bottom-0 z-50 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-10 lg:hidden"
  aria-label="Sections"
>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-full bg-gradient-to-t from-ink-900 via-ink-900/85 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto flex max-w-sm items-center justify-between gap-1 rounded-full border border-dashed border-paper-faint/60 bg-ink-900/80 p-1 backdrop-blur-xl"
  >
    {
      links.map((item) => (
        <a
          href={item.href}
          aria-label={item.label}
          data-section-link
          class="thumb-link flex-1 whitespace-nowrap rounded-full px-1.5 py-2.5 text-center font-mono text-[0.62rem] font-semibold uppercase tracking-[0.1em] text-paper-dim transition-colors duration-200 active:bg-ink-600 active:text-paper"
        >
          {item.short}
        </a>
      ))
    }
  </div>
</nav>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const sentinel = document.querySelector<HTMLElement>('[data-nav-sentinel]');
  const solid = ['bg-ink-900/75', 'backdrop-blur-xl', 'border-b', 'border-dashed', 'border-ink-500/70'];

  // Local time in Delhi, to the minute. Updates on the minute boundary, not on a fast timer.
  const clock = document.querySelector<HTMLElement>('[data-nav-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' });
    const tick = () => {
      clock.textContent = fmt.format(new Date());
      window.setTimeout(tick, 60_000 - (Date.now() % 60_000) + 50);
    };
    tick();
  }

  // IntersectionObserver instead of a scroll listener: it fires once per crossing, not per frame.
  if (header && sentinel) {
    new IntersectionObserver(([entry]) => {
      const scrolled = !entry!.isIntersecting;
      solid.forEach((c) => header.classList.toggle(c, scrolled));
    }).observe(sentinel);
  }
</script>
